# ─── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string (auto-provisioned on Replit)
DATABASE_URL=postgresql://user:password@localhost:5432/barbiefun

# ─── Session ───────────────────────────────────────────────────────────────────
SESSION_SECRET=your-super-secret-session-key-min-32-chars

# ─── Server ────────────────────────────────────────────────────────────────────
# Set by Replit automatically — do not set manually
PORT=5000
BASE_PATH=/api

# ─── Frontend (Vite — prefix with VITE_ to expose to client) ──────────────────

# Admin wallet address — only this wallet can access the Admin Dashboard
VITE_ADMIN_WALLET_ADDRESS=0xYourAdminWalletAddressHere

# WalletConnect Project ID (get free at https://cloud.walletconnect.com)
VITE_WALLETCONNECT_PROJECT_ID=your-walletconnect-project-id

# ─── NFT (also configurable in src/config/nft.config.ts) ──────────────────────
# These are set in src/config/nft.config.ts — no env var needed
# NFT_CONTRACT_ADDRESS=0xYourAfricaNFTContractAddress
# NFT_CHAIN_ID=204005
# NFT_RPC_URL=https://x1rpc.infrafc.org
