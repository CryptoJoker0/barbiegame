modules = ["nodejs-20", "web", "bash", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
VITE_NFT_CONTRACT_ADDRESS = "The AFRICA X1 NFT contract has not been deployed yet.  Do not block development because of \"VITE_NFT_CONTRACT_ADDRESS\".  Continue using the existing database-backed NFT ownership system.  Requirements  1. Remove the requirement for \"VITE_NFT_CONTRACT_ADDRESS\". It should be optional.  2. Continue verifying NFT ownership from the existing Supabase database.  3. When a wallet connects:        - Check if the wallet exists in the database.    - Retrieve the NFTs owned by that wallet.    - If the wallet owns one or more AFRICA X1 NFTs, mark it as verified.  4. Use this verification for:        - NFT Staking    - Marketplace access    - Game access    - Future reward distribution  5. Keep the architecture modular so that later we can replace database verification with on-chain verification using the AFRICA X1 NFT smart contract without changing the UI or user experience.  6. Add a verification service with two providers:        - \"database\" (default)    - \"blockchain\" (future)  The application should use the database provider now. When the smart contract is deployed, we will simply switch to the blockchain provider.  Do not use mock data or demo mode. Use the real Supabase data that already powers the AFRICA X1 application."
